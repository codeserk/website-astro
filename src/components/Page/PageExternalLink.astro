---
interface Props {
  readonly name: string
  readonly href: string
}

const { name, href } = Astro.props
---

<a class={`link ${name}`} href={href} target="_blank">
  {
    name === 'github' ? (
      <img class="icon" src="/image/social/github.png" alt="GitHub" />
    ) : (
      <span class="icon">:loop:</span>
    )
  }
  {name}
</a>

<style>
  .link {
    display: flex;
    line-height: 40px;
    text-transform: uppercase;
    align-items: center;
    gap: 12px;

    .icon {
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      width: 24px;
      height: 24px;
      margin-bottom: 5px;
      text-align: center;
    }

    .icon :global(.pixel-icon) {
      display: block;
      margin: 0 !important;
      vertical-align: unset;
    }

    &.website {
      &::before {
        /* content: '➿ '; */
        /* vertical-align: -5px; */
      }
      /* &&: privacy; */
    }
  }
</style>
